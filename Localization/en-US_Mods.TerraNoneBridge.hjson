		Stats: {
			Damage: Dmg:{0}
			Defense: Def:{0}
			Crit: Crit:{0}%
			Speed: Spd:{0}
			Value: Val:{0}
			Knockback: KB:{0}({1})

			KnockbackLevel: {
				None: None
				VeryWeak: Very Weak
				Weak: Weak
				Average: Average
				Strong: Strong
				VeryStrong: Very Strong
				Insane: Insane
			}
		}

		// [New] Currency Units
		Currency: {
			Platinum: p
			Gold: g
			Silver: s
			Copper: c
		}

		Desc:
			'''
			[Description]
			{0}
			'''
		DroppedByHeader: "[Dropped By]"
		SoldByHeader: "[Sold By]"
		RecipeHeader: "[Recipes] (Total {0}):"
		RecipeRow: - {0} @ {1} -> {2}
		RecipeRowDetailed: - {0} @ {1}{2} -> {3}
		NoRecipe: This item cannot be crafted, and has no known drop/shop source.
		TileWorkbench: Workbench
		TileHand: Hand
	}

	Player: {
		Header: === Player: {0} ===
		// 为了安全起见，包含大量符号的行建议加引号
		SubHeader: Life: {0}/{1} | Mana: {2}/{3} | Def: {4}
		EquipHeader: "[Equipment]"
		Armor: "  Armor: {0}"
		Accessories: "  Acc: {0}"
		Misc: "  Misc: {0}"
		InvHeader: "[Inventory]"
		Coins: "  Coins: {0}"
		Ammo: "  Ammo: {0}"
		Hotbar: "  Hotbar: {0}"
		Main: "  Main: {0}"
		VoidHeader: "[Void Vault]"
		BankHeader: "[Personal Storage]"
		BankPig: "  [Piggy Bank] {0}"
		BankSafe: "  [Safe] {0}"
		BankForge: "  [Defender's Forge] {0}"
		Empty: (Empty)
	}
}
